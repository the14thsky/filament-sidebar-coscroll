{
    "name": "the14thsky/filament-sidebar-coscroll",
    "description": "Makes the Filament panel sidebar scroll together with the page",
    "keywords": [
        "the14thsky",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-sidebar-coscroll"
    ],
    "homepage": "https://github.com/the14thsky/filament-sidebar-coscroll",
    "support": {
        "issues": "https://github.com/the14thsky/filament-sidebar-coscroll/issues",
        "source": "https://github.com/the14thsky/filament-sidebar-coscroll"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "the14thsky",
            "email": "the14thsky@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "The14thsky\\SidebarCoscroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "The14thsky\\SidebarCoscroll\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "The14thsky\\SidebarCoscroll\\SidebarCoscrollServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
